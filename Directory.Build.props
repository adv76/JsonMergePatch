<Project>
    <PropertyGroup>
        <Authors>adv76</Authors>
        <Company>adv76</Company>
        <Product>JsonMergePatch</Product>
        <PackageTags>json;merge;patch;jsonmerge;jsonpatch;jsonmergepatch;json-merge;json-patch;json-merge-patch</PackageTags>
        <PackageProjectUrl>https://github.com/adv76/JsonMergePatch</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <Copyright>Copyright (c) 2026 adv76</Copyright>
        <RepositoryUrl>https://github.com/adv76/JsonMergePatch</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>